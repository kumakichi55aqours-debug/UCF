  subjects:
  - subject: "\u57FA\u672C"
    subSubjects:
    - subject: "\u57FA\u672C\u30EB\u30FC\u30EB"
      text: "\u30C7\u30C3\u30AD\u679A\u6570\u306F30\u679A\u3002\n\u521D\u671F\u624B\u672D\u306F4\u679A\u3002\u521D\u671F\u30E9\u30A4\u30D5\u306F30\u3002\n\u52DD\u5229\u6761\u4EF6\u306F\u3001\u76F8\u624B\u30E9\u30A4\u30D5\u30920\u306B\u3059\u308B\u4E8B\u3067\u3059\u3002\n\n\u30C7\u30C3\u30AD\u5207\u308C\u306A\u3069\u306B\u3088\u308B\u6557\u5317\u306A\u3069\u306F\u3042\u308A\u307E\u305B\u3093\u3002\n\n\u5148\u653B1\u30BF\u30FC\u30F3\u76EE\u306E\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u4EE5\u4E0B\u306E\u884C\u52D5\u304C\u51FA\u6765\u307E\u305B\u3093\u3002\n\u25CF\u30C9\u30ED\u30FC\u30D5\u30A7\u30A4\u30BA\u306B\u3088\u308B\u30C9\u30ED\u30FC\n\u25CF\u30D0\u30C8\u30E9\u30FC\u30AB\u30FC\u30C9\u306E\u6280\u306E\u4F7F\u7528"
      pagePrefab: {fileID: 0}
    - subject: "\u30D5\u30A7\u30A4\u30BA"
      text: 
      pagePrefab: {fileID: 800000, guid: 82b19aa93a8d24c48b89d7338528437b, type: 3}
    - subject: "\u30EA\u30BD\u30FC\u30B9"
      text: "\u3053\u306E\u30B2\u30FC\u30E0\u306B\u306F\u3001\u30AB\u30FC\u30C9\u3092\u4F7F\u7528\u3059\u308B\u306E\u306B\u5FC5\u8981\u306A\u30EA\u30BD\u30FC\u30B9\u304C<color=#FFCC66>2\u7A2E\u985E</color>\u5B58\u5728\u3057\u307E\u3059\u3002\n\u25CF\u30B3\u30B9\u30C8\u2026\u30AB\u30FC\u30C9\u3092\u5834\u306B\u51FA\u3059\u306E\u306B\u5FC5\u8981\u306A\u30EA\u30BD\u30FC\u30B9\u3067\u3059\u3002\u30AB\u30FC\u30C9\u306E\u5DE6\u4E0A\u90E8\u306B\u8A18\u3055\u308C\u3066\u3044\u307E\u3059\u3002\n\u8868\u8A18\u304C\u300C-\u300D\u306E\u3082\u306E\u306F\u3001\u30B3\u30B9\u30C80\u306E\u30AB\u30FC\u30C9\u3067\u3042\u308A\u3001\u6B8B\u308A\u306E\u30B3\u30B9\u30C8\u304C\u306A\u304F\u3066\u3082\u4F7F\u7528\u3067\u304D\u307E\u3059\u3002\n\n\u25CF\u30A8\u30CD\u30EB\u30AE\u30FC\u2026\u30D0\u30C8\u30E9\u30FC\u30AB\u30FC\u30C9\u304C\u6280\u3092\u4F7F\u7528\u3059\u308B\u306E\u306B\u5FC5\u8981\u306A\u30EA\u30BD\u30FC\u30B9\u3067\u3059\u3002\u30D0\u30C8\u30E9\u30FC\u30AB\u30FC\u30C9\u306E\u6280\u306B\u300CEN
        \u3007\u3007\u300D\u3068\u3044\u3046\u5F62\u3067\u8A18\u3055\u308C\u3066\u3044\u307E\u3059\u3002\n\n\u3069\u3061\u3089\u3082\u3001\u4F7F\u7528\u3059\u308B\u969B\u306B\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u5168\u4F53\u30EA\u30BD\u30FC\u30B9\u304B\u3089\u6D88\u8CBB\u3055\u308C\u307E\u3059\u3002\n\u3053\u306E\u30EA\u30BD\u30FC\u30B9\u306E\u4E8B\u3092\u305D\u308C\u305E\u308C\u300C<color=#FFCC66>\u4FDD\u6709\u30B3\u30B9\u30C8</color>\u300D\u300C<color=#FFCC66>\u4FDD\u6709\u30A8\u30CD\u30EB\u30AE\u30FC</color>\u300D\u3068\u3044\u3044\u307E\u3059\u3002\n\n\u4FDD\u6709\u30B3\u30B9\u30C8\u3001\u4FDD\u6709\u30A8\u30CD\u30EB\u30AE\u30FC\u306F\u300C<color=#FFCC66>\u81EA\u5206\u306E\u30C9\u30ED\u30FC\u30D5\u30A7\u30A4\u30BA\u306B\u30EA\u30BB\u30C3\u30C8</color>\u3055\u308C\u307E\u3059\u3002\n<color=#FFCC66>\u6BCE\u30BF\u30FC\u30F3\u3001\u4FDD\u6709\u30B3\u30B9\u30C8\u3001\u4FDD\u6709\u30A8\u30CD\u30EB\u30AE\u30FC\u306F+1\u3055\u308C\u3066\u3044\u304D\u307E\u3059</color>\u3002"
      pagePrefab: {fileID: 0}
