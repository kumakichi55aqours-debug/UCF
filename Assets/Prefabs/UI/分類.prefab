  m_text: "\u30AB\u30FC\u30C9\u306B\u306F\u4E3B\u306B3\u7A2E\u985E\u306E\u5206\u985E\u304C\u3042\u308A\u307E\u3059\u3002\n\n\n\n\u5DE6\u304B\u3089\u9806\u306B\n\u30D0\u30C8\u30E9\u30FC\u30AB\u30FC\u30C9\u3001\u4F5C\u6226\u30AB\u30FC\u30C9\u3001\u30D5\u30A3\u30FC\u30EB\u30C9\u30AB\u30FC\u30C9\u3067\u3059\u3002\n\u305D\u308C\u305E\u308C\u3001\u30D0\u30C8\u30E9\u30FC\u30BE\u30FC\u30F3(B\u30BE\u30FC\u30F3)\u3001\u30BF\u30AF\u30C6\u30A3\u30AF\u30B9\u30BE\u30FC\u30F3(T\u30BE\u30FC\u30F3)\u3001\u30D5\u30A3\u30FC\u30EB\u30C9\u30BE\u30FC\u30F3(F\u30BE\u30FC\u30F3)\n\u3068\u3044\u3046\u5834\u6240\u306B\u30AB\u30FC\u30C9\u3092\u51FA\u3057\u3066\u4F7F\u7528\u3057\u307E\u3059\u3002\n\n\n\t\t\u2190\u30AB\u30FC\u30C9\u306B\u306F\u305D\u308C\u305E\u308C<color=#FFCC66>\u30B3\u30B9\u30C8</color>\u304C\u8A2D\u5B9A\u3055\u308C\u3066\u304A\u308A\n\t\t\u30B3\u30B9\u30C8\u3092\u6E80\u305F\u3057\u3066\u3044\u306A\u3044\u5834\u5408\u306F\u3001\u30AB\u30FC\u30C9\u3092\u5834\u306B\u51FA\u3059\u4E8B\u304C\u3067\u304D\u307E\u305B\u3093\u3002\n\t\t(\u8868\u8A18\u304C\u300C-\u300D\u306B\u306A\u3063\u3066\u3044\u308B\u3082\u306E\u306F\u30B3\u30B9\u30C80\u306E\u30AB\u30FC\u30C9\u3067\u3042\u308A\u3001\u30B3\u30B9\u30C8\u304C\u306A\u304F\u3066\u3082\u4F7F\u3048\u307E\u3059\u3002)"
